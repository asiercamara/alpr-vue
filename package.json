    "lint-staged": "^16.4.0",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^1.6.4",
