{
  "name": "alpr-vue",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.workers.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:all": "pnpm build && pnpm docs:build",
    "deploy:surge": "bash ./scripts/deploy-surge.sh",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:ci": "pnpm audit --audit-level high --prod",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "check:all": "node scripts/check.mjs --all"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "onnxruntime-web": "^1.30.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitepress-theme-app-docs": "^1.2.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=8.0.5",
      "vitepress>vite": "^5.4 || ^6.0",
      "protobufjs": "^7.6.6",
      "@protobufjs/utf8": ">=1.1.1",
      "semver@^6.3.1": "^7.7.4",
      "postcss": "^8.5.29",
      "nanoid": "^3.3.18",
      "uuid": "^11.1.1",
      "js-yaml": "^3.15.2",
      "js-cookie": "^3.0.8",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "@babel/core": "^7.29.6",
      "@humanfs/node": "^0.16.8",
      "postcss-selector-parser": "^7.1.6",
      "brace-expansion@^2.0.2": "^2.1.7",
      "brace-expansion@^5.0.5": "^5.0.12",
      "katex": "^0.18.2"
    }
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.mjs": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
